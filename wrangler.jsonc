{
  "$schema": "./node_modules/wrangler/config-schema.json",

  "name": "royeyal-com",
  "main": "worker/index.js",
  "compatibility_date": "2026-07-30",

  // Cloudflare dashboard -> top-right account dropdown, or `wrangler whoami`.
  // Not a secret — it appears in every dashboard URL. The API token in .env
  // is the secret, and that stays gitignored.
  "account_id": "c84d1e6f99329d834a7cb284c20292dd",

  // NOTE: royeyal.com IS attached as a custom domain — it was created by
  // an earlier deploy and persists in Cloudflare (account-level Worker
  // domain). It is deliberately NOT declared here: wrangler reconciles a
  // `routes` key against GET /zones/:id/workers/routes, which this API
  // token cannot read, so declaring it makes every deploy exit non-zero
  // even though the upload succeeds. Restore the line below if the token
  // ever gains Zone -> Workers Routes -> Edit:
  //   "routes": [{ "pattern": "royeyal.com", "custom_domain": true }],
  //
  // Apex is canonical — it matches hello@royeyal.com and the footer's
  // terminal prompt. www is a Cloudflare Redirect Rule, not a second
  // custom domain: with run_worker_first false the asset server answers
  // before the worker runs, so the worker could never redirect it.

  // Off: royeyal.com is confirmed serving, and a live *.workers.dev URL
  // would be a second indexable copy of the whole site. Flip to true
  // temporarily if you ever need a URL while the custom domain is broken.
  "workers_dev": false,

  // Static hosting for dist/. Vite already writes hashed filenames into
  // index.html on every build, so no stable-URL worker logic is needed —
  // see docs/cloudflare-workers.md for the Webflow-pivot scenario where
  // run_worker_first must flip to true.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": false,
  },

  "observability": {
    "enabled": true,
  },
}
