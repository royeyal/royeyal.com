{
  "$schema": "./node_modules/wrangler/config-schema.json",

  "name": "royeyal-com",
  "main": "worker/index.js",
  "compatibility_date": "2026-07-30",

  // Cloudflare dashboard -> top-right account dropdown, or `wrangler whoami`.
  // Not a secret — it appears in every dashboard URL. The API token in .env
  // is the secret, and that stays gitignored.
  "account_id": "c84d1e6f99329d834a7cb284c20292dd",

  // royeyal.com is declared here as a custom domain, which makes the
  // attachment part of this file rather than invisible account state.
  //
  // It was commented out for a long time, and the reason is worth
  // keeping: wrangler reconciles this key against
  // GET /zones/:id/workers/routes, and the previous API token could not
  // read that endpoint — so declaring it made every deploy exit non-zero
  // even though the upload had succeeded. The token was reissued on
  // 2026-08-22 with Zone -> Workers Routes, which is the condition the
  // old note said to restore this under. Verified against the live API
  // before uncommenting, not assumed.
  //
  // If deploys start exiting non-zero here again, suspect the token
  // before suspecting the route:
  //   curl -s https://api.cloudflare.com/client/v4/zones/$ZONE/workers/routes \
  //     -H "Authorization: Bearer $CLOUDFLARE_API_TOKEN"
  "routes": [{ "pattern": "royeyal.com", "custom_domain": true }],
  //
  // Apex is canonical — it matches hello@royeyal.com and the footer's
  // terminal prompt. www is a Cloudflare Redirect Rule, not a second
  // custom domain: with run_worker_first false the asset server answers
  // before the worker runs, so the worker could never redirect it.

  // Off: royeyal.com is confirmed serving, and a live *.workers.dev URL
  // would be a second indexable copy of the whole site. Flip to true
  // temporarily if you ever need a URL while the custom domain is broken.
  "workers_dev": false,

  // Static hosting for dist/. Vite already writes hashed filenames into
  // index.html on every build, so no stable-URL worker logic is needed —
  // see docs/cloudflare-workers.md for the Webflow-pivot scenario where
  // run_worker_first must flip to true.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": false,

    // Without this the asset server answers an unknown path with a 404
    // and a ZERO-BYTE body — a blank white page. Serves public/404.html
    // instead, which Vite copies to dist/ verbatim.
    //
    // Deliberately NOT "single-page-application": that mode returns the
    // CV with a 200 for every made-up path, which is a lie to crawlers
    // and would let an infinite URL space get indexed. This site has
    // exactly one real page, so a wrong path genuinely is a 404.
    "not_found_handling": "404-page",
  },

  "observability": {
    "enabled": true,
  },
}
